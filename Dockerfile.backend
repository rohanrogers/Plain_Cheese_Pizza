# ─────────────────────────────────────────────────────────────────────────────
# Brightloop IAM Backend — Docker Image
# Base: Ubuntu 22.04 LTS | Runtime: Node.js 20 LTS
# ─────────────────────────────────────────────────────────────────────────────
FROM ubuntu:22.04 AS base

# Prevent interactive prompts during apt
ENV DEBIAN_FRONTEND=noninteractive

# Install Node.js 20 via NodeSource + build tools for native modules
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg \
        build-essential \
        python3 \
        sqlite3 \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ─── Dependencies stage ───────────────────────────────────────────────────────
FROM base AS deps

WORKDIR /app

# Copy package manifests first to leverage Docker layer cache
COPY package.json package-lock.json ./

# Install production deps only (native modules like better-sqlite3 compile here)
RUN npm ci --only=production

# ─── Runtime stage ────────────────────────────────────────────────────────────
FROM base AS runtime

ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}

WORKDIR /app

# Copy compiled native modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy application source
COPY backend/   ./backend/
COPY .env.example ./.env

# Create data directory for SQLite DB (writable volume in production)
RUN mkdir -p /app/data && chmod 777 /app/data

# Non-root user for security
RUN groupadd --system brightloop && useradd --system --gid brightloop brightloop
RUN chown -R brightloop:brightloop /app
USER brightloop

EXPOSE 5000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:5000/api/health || exit 1

CMD ["node", "backend/server.js"]

