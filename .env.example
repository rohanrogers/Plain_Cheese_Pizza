DATABASE_URL=postgresql+psycopg://brightloop:brightloop@127.0.0.1:5433/brightloop
FRONTEND_URL=http://127.0.0.1:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=billing@brightloop.local
# Enable only for local development; messages are visible to administrators.
LOCAL_MAILBOX=true
# For an explicit SQLite development fallback:
# DATABASE_URL=sqlite:///./brightloop.db

# Required to enroll authenticators; generate once and keep private/backed up.
# .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
SECURE_COOKIES=false
