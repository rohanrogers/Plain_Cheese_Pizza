# Brightloop IAM Service Environment Configuration
PORT=5000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://makeat_user:supersecret@localhost:5432/makeat
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=makeat
# PGUSER=makeat_user
# PGPASSWORD=supersecret

# Cryptographic Session & JWT Secret (Replace with secure random key in production)
SESSION_SECRET=your_32_bytes_long_session_secret_key_here
JWT_SECRET=your_32_bytes_long_jwt_secret_key_here

# Two-Factor Authentication (2FA) Parameters
TOTP_DIGITS=6
TOTP_TIME_STEP=30
TOTP_SECRET_LENGTH=32

# SMTP Email Configuration (for OTP & Password Reset dispatch)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

